# Application Environment
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# Universal Database Connection (Local Docker, Neon, or Managed PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/research_factors?schema=public"

# Authentication Secrets
JWT_SECRET="research-factors-secure-jwt-secret-key-32-chars-min"
JWT_EXPIRES_IN="7d"

# Storage Abstraction: local | cloudinary | r2
STORAGE_PROVIDER=local

# Local Storage Provider Settings
LOCAL_STORAGE_PATH="./uploads"
LOCAL_STORAGE_PUBLIC_URL="http://localhost:5000/uploads"

# Cloudinary Storage Provider Settings (When STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 / S3 Settings (When STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="research-factors-media"
R2_PUBLIC_URL="https://media.researchfactors.com"

# Email Provider Configuration: smtp | json_log
EMAIL_PROVIDER=json_log
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@researchfactors.com"
SMTP_FROM_NAME="Research Factors"

# Redis Cache & Queue (Optional)
REDIS_URL="redis://localhost:6379"
